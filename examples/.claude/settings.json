{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/node_modules/eslint-plugin-agent-guard/bin/agent-guard.mjs\" protect" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/node_modules/eslint-plugin-agent-guard/bin/agent-guard.mjs\" lint" }
        ]
      }
    ]
  }
}
